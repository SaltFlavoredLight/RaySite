            "textColor": { "mode": "basic", "color": "#25312B" },
            "background": { "mode": "basic", "color": "#F5F3ED" },
            "paddingTop": { "mode": "px", "value": 18 },
            "paddingBottom": { "mode": "px", "value": 18 },
            "paddingLeft": { "mode": "%", "value": 7 },
            "paddingRight": { "mode": "%", "value": 7 },
            "borderMode": "solid",
            "borderBottom": { "mode": "px", "value": 1, "color": "#E7E3D8" }
          },
          "size": {}
        }
      }
    }
