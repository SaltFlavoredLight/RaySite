{
  "colorPalette": [
    "#111111", 
    "#1A1A1A", 
    "#333333", 
    "#555555", 
    "#777777", 
    "#999999", 
    "#BBBBBB", 
    "#DDDDDD", 
    "#F2F2F2", 
    "#FFFFFF", 
    "#000000", 
    "#E2E2E2"
  ],
  "gFontsURLs": "https://fonts.googleapis.com/css2?family=Inter:wght@300;600&family=Space+Grotesk:wght@300;500;700&display=swap",
  "Text": {
    "H1": {
      "fontSize": "80px",
      "fontWeight": "700",
      "fontFamily": "Space Grotesk",
      "color": "var(--theme1)",
      "textAlign": "left",
      "lineHeight": 1.1,
      "letterSpacing": "-3px",
      "uppercase": true
    },
    "H2": {
      "fontSize": "32px",
      "fontWeight": "500",
      "fontFamily": "Space Grotesk",
      "color": "var(--theme2)",
      "textAlign": "left",
      "lineHeight": 1.3,
      "uppercase": true
    },
    "P": {
      "fontSize": "16px",
      "fontWeight": "300",
      "fontFamily": "Inter",
      "color": "var(--theme3)",
      "textAlign": "left",
      "lineHeight": 1.8
    }
  },
  "layout": {
    "maxWidthContent": "1400px",
    "mobileSize": 768
  },
  "buttons": {
    "systemGlobal": {
      "translation": 0.3,
      "strokeBorder": 1,
      "height": "50px",
      "minWidth": "180px",
      "fontSize": "13px",
      "paddingX": 30
    },
    "systemButton": {
      "borderRadius": "0px",
      "backgroundColor": "var(--theme11)",
      "textColor": "var(--theme10)"
    },
    "systemReverseButton": {
      "borderRadius": "0px",
      "backgroundColor": "transparent",
      "textColor": "var(--theme1)",
      "borderColor": "var(--theme1)"
    }
  },
  "spacing": {
    "xl": "160px",
    "radiusSm": "0px",
    "radiusMd": "0px",
    "radiusLg": "0px"
  },
  "header": {
    "mode": "static",
    "data": {
      "mode": "headerbar",
      "headerColor": "rgba(255, 255, 255, 0.8)",
      "headerBlur": "20px",
      "headerStrokeDown": true,
      "headerStrokeDownColor": "var(--theme12)",
      "headerInnerTop": "25px",
      "headerInnerBottom": "25px",
      "contextSetting": {
        "left": ["logo"],
        "center": ["links"],
        "right": ["rightbutton"]
      },
      "linkColor": "var(--theme1)",
      "linkHoverColor": "var(--theme5)"
    }
  }
}